# Sony's Camera Remote SDK (CrSDK) is proprietary and requires accepting
# Sony's own license agreement to download -- it is NOT redistributed in
# this repo. See docs/BUILDING.md for how to obtain it and where to place
# it locally.
third_party/CrSDK/

# Real camera pairing credentials (IP/MAC/userId/password) -- never
# committed. See server/saved_cameras.json.example for the format.
server/saved_cameras.json

# User's Saved Recipes library -- local runtime state, not source.
server/saved_recipes.json

# Docker deployment's bind-mounted copies of the same two files (see
# docs/DOCKER.md) -- same reasons as above, different path.
scripts/data/

# Build output
server/build/
*.o
*.so
sonyconfig_web
build/

# OS/editor cruft
.DS_Store
*.swp

# iOS app (Sony Config) -- Xcode user-specific state and build products.
# The .xcodeproj itself (generated by XcodeGen from project.yml) is
# committed so the project opens without regenerating it, but per-user
# scheme/window state and DerivedData never should be.
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/DerivedData/
ios/**/.build/
